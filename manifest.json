{
  "manifest_version": 3,
  "name": "Frostpane",
  "version": "1.1",
  "description": "A calm, glass-textured new tab homepage with a live clock, quick search, and a 12-tile bookmark grid.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://*.gstatic.com/*"
  ]
}
